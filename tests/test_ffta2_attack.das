var failed = 0
var total = 0

def find_unit(units : array<Unit2>; name : string) : int {
    for (i in range(length(units))) {
        if (units[i].name == name) {
            return i
        }
    }
    return -1
}

def apply_edit(var att, tgt : Unit2; var game_facing : int&; key : string; v : int) {
    if (key == "a") {
        att.raw[0] = v
    } elif (key == "d") {
        tgt.raw[1] = v
    } elif (key == "w") {
        att.equip[0] = read_item2(v)
    } elif (key == "s2") {
        att.equip[2] = read_item2(v)
    } elif (key == "s4") {
        att.equip[4] = read_item2(v)
    } elif (key == "t") {
        tgt.equip[0] = read_item2(v)
    } elif (key == "e") {
        tgt.equip[0].bonus[5] = v
    } elif (key == "f") {
        game_facing = v
    } elif (key == "b") {
        att.bare_power = v
    } elif (key == "af") {
        tgt.affinity[0] = v
    } elif (key == "sa") {
        att.status[v >> 3] = uint8(uint(att.status[v >> 3]) | (1u << uint(v & 7)))
    } elif (key == "st") {
        tgt.status[v >> 3] = uint8(uint(tgt.status[v >> 3]) | (1u << uint(v & 7)))
    } elif (key == "sup") {
        att.support = v
    } elif (key == "tsup") {
        tgt.support = v
    } elif (key == "tj") {
        set_job2(tgt, v)
    }
}

[export]
def main() : int {
    gba_load_rom(gui_arg("--rom", ""))
    gba_load_state(gui_arg("--state", ""))
    var units : array<Unit2>
    let err = read_battle2(units)
    if (err != "") {
        print("FAIL {err}\n")
        return 1
    }
    let luso = find_unit(units, "Luso")
    let sasarr = find_unit(units, "Sasarr")
    for (c in CASES) {
        let parts <- split(c, " | ")
        var att = units[luso]
        var tgt = units[sasarr]
        att.x = 9
        att.y = 8
        var game_facing = 1
        for (e in split(parts[0], " ")) {
            let kv <- split(e, "=")
            apply_edit(att, tgt, game_facing, kv[0], to_int(kv[1]))
        }
        tgt.facing = FACING_FROM_GAME[game_facing]
        recompute_unit(att)
        recompute_unit(tgt)
        let want <- split(parts[1], " ")
        let f <- fight2(att, tgt, side_of2(att, tgt))
        total++
        if (f.hit != to_int(want[0]) || (f.damage & 0xFFFF) != to_int(want[1])) {
            failed++
            print("FAIL {parts[0]}: game {want[0]} / {want[1]}, model {f.hit} / {f.damage} ({SIDE2_NAMES[int(f.side)]}, base {f.base})\n")
        }
    }
    // the next Attack from the generators: Sasarr's own (hit) and the battle's
    var att = units[luso]
    var tgt = units[sasarr]
    att.x = 9
    att.y = 8
    total++
    if (tgt.rng_seed != SAMPLE_SASARR_SEED) {
        failed++
        print("FAIL Sasarr's generator {tgt.rng_seed}\n")
    }
    let f99 <- fight2(att, tgt, side_of2(att, tgt))
    for (c in REAL_99) {
        let p <- split(c, " ")
        let r = roll_attack(f99, uint(to_uint64(p[0])), SAMPLE_SASARR_SEED)
        total++
        if (r.damage != to_int(p[1])) {
            failed++
            print("FAIL real attack, seed {p[0]}: game {p[1]}, model {r.damage}\n")
        }
    }
    tgt.status[7] = uint8(2)                // Evasion up: 80 %
    let f80 <- fight2(att, tgt, side_of2(att, tgt))
    for (c in REAL_80) {
        let p <- split(c, " ")
        let r = roll_attack(f80, uint(to_uint64(p[0])), uint(to_uint64(p[1])))
        total++
        if (r.damage != to_int(p[2])) {
            failed++
            print("FAIL real attack 80 %, seeds {p[0]} {p[1]}: game {p[2]}, model {r.damage}\n")
        }
    }
    print(failed == 0 ? "PASS {total} cases\n" : "FAIL {failed} of {total}\n")
    return failed == 0 ? 0 : 1
}
