options gen2

// Icon ids of assets/icons/ffta_icons16.png (our pixel art, made by
// assets/icons/make_icons.py, which prints these lines): id = ix | iy << 8.
module icons shared public

let ICON_INFO = 0    // (0, 0)
let ICON_TURNS = 1    // (1, 0)
let ICON_ATTACK = 2    // (2, 0)
let ICON_UNIT = 3    // (3, 0)
let ICON_ENEMY = 4    // (4, 0)
let ICON_GAME = 5    // (5, 0)
let ICON_ROSTER = 256    // (0, 1)
let ICON_INSPECTOR = 257    // (1, 1)
let ICON_CALC = 258    // (2, 1)
let ICON_FIELD = 259    // (3, 1)
let ICON_SCREEN = 260    // (4, 1)
let ICON_LOAD = 261    // (5, 1)
let ICON_TURN_CCW = 512    // (0, 2)
let ICON_TURN_CW = 513    // (1, 2)
let ICON_EXPORT = 514    // (2, 2)
let ICON_FIT = 515    // (3, 2)
let ICON_OPEN = 516    // (4, 2)
let ICON_CLOSED = 517    // (5, 2)
let ICON_CHART = 768    // (0, 3)
